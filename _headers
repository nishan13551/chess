# Netlify response headers.
#
# X-Robots-Tag is the belt to the meta tag's braces: it applies to every file,
# not just the HTML, and search engines honour it even for direct file hits.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
